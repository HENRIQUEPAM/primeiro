<?xml version="1.0" encoding="utf-8"?>
<!--
  Cartao de contato. Alvos grandes, rotulo em texto, e o cartao inteiro
  clicavel para o caminho de um toque so.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/contact_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/best_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/app_video_button"
            style="@style/ContactActionButton"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/whatsapp_chat_button"
            style="@style/ContactActionButton" />

        <Button
            android:id="@+id/phone_button"
            style="@style/ContactActionButton" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
