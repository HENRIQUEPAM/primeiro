<?xml version="1.0" encoding="utf-8"?>
<!--
  Duas seções, uma visível de cada vez: login_section (digitar a senha —
  a mesma em qualquer instalação do app, ver AdminPassword.kt) e
  panel_section (os recursos liberados, só depois de entrar). ScrollView
  por fora pelo mesmo motivo de activity_people.xml — o teclado abrindo
  sobre o campo de senha não pode empurrar o botão para fora da tela sem
  um jeito de rolar até ele.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/advanced_features"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Digitar a senha. -->
        <LinearLayout
            android:id="@+id/login_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/login_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/password_input_layout"
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/admin_password_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/password_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/login_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/decline_red"
                android:textSize="15sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/login_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/admin_enter_button"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Só aparece depois de entrar com a senha certa. -->
        <LinearLayout
            android:id="@+id/panel_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Switch
                android:id="@+id/auto_answer_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/admin_auto_answer_switch"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/amber_banner_bg"
                android:padding="12dp"
                android:text="@string/admin_auto_answer_explanation"
                android:textColor="@color/amber_banner_text"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
