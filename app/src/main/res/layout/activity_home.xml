<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/contacts_title"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:background="@color/amber_banner_bg"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/no_contacts"
        android:textSize="18sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contacts_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:clipToPadding="false" />

    <Button
        android:id="@+id/add_contact_button"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:text="@string/add_contact"
        android:textSize="18sp" />

    <Button
        android:id="@+id/privacy_button"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/privacy_title"
        android:textSize="15sp" />

    <!-- Pareamento manual: cada aparelho mostra o próprio código; quem quer
         ser chamado pelo app cola esse código no campo "Código do aparelho"
         de "Adicionar contato" no OUTRO aparelho. Sem isto visível e fácil de
         copiar, a chamada pelo app não tem como ser configurada — daí o
         cartão, não mais um texto minúsculo sem rótulo. -->
    <LinearLayout
        android:id="@+id/my_code_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/navy_050"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/my_code_label"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/my_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textIsSelectable="true"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/copy_code_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/copy_code"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
