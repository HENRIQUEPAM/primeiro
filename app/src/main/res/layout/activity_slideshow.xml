<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Dois ImageViews sobrepostos: a foto nova entra por cima da antiga. -->
    <ImageView
        android:id="@+id/image_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/photo_description" />

    <ImageView
        android:id="@+id/image_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@string/photo_description" />

    <!-- Quem está na foto. Fica sobre a imagem, sem os controles, porque é o
         que dá sentido ao reconhecimento para quem olha o porta-retrato: a foto
         aparece e o nome aparece junto. Some quando ninguém foi reconhecido. -->
    <TextView
        android:id="@+id/photo_names"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC0D2B52"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp"
        android:shadowColor="#FF000000"
        android:shadowRadius="6"
        android:textColor="#FFFFFFFF"
        android:textSize="26sp"
        android:visibility="gone" />

    <!-- Acervo vazio: convite direto para adicionar. -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_photos_title"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/no_photos_hint"
            android:textColor="#FFCCCCCC"
            android:textSize="17sp"
            android:gravity="center" />

        <Button
            android:id="@+id/empty_add_button"
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:layout_marginTop="28dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/add_photos"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Ligar para quem está na foto atual — dois tamanhos do mesmo botão,
         nunca os dois visíveis juntos. Sozinho na tela (estado de repouso,
         a maior parte do tempo), fica pequeno e discreto, para não competir
         com a foto. Ao tocar a tela — junto com o nome e o menu — cresce
         para o tamanho com rótulo de texto: "ícone sozinho é ambíguo para
         usuário idoso, 'Ligar' escrito não é" (mesma regra de
         activity_call.xml), mas só precisa disso quando já se está
         interagindo com a tela. -->
    <ImageButton
        android:id="@+id/photo_call_button_compact"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:background="@drawable/bg_call_button"
        android:contentDescription="@string/call_people_in_photo"
        android:elevation="6dp"
        android:padding="7dp"
        android:src="@drawable/ic_call"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/photo_call_button_expanded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/call_people_in_photo"
        android:elevation="6dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_call_button"
            android:importantForAccessibility="no"
            android:padding="18dp"
            android:src="@drawable/ic_call" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:shadowColor="#000000"
            android:shadowRadius="6"
            android:text="@string/start_call"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Único controle: um toque na tela mostra este botão, que abre a lista
         de opções (chamar, adicionar fotos, quem está nas fotos, tempo de
         cada foto, como exibir as fotos, privacidade). Some sozinho depois de
         alguns segundos, como antes — só que agora é um botão, não cinco.
         Canto superior esquerdo, não embaixo: a legenda de nomes ocupa a
         borda inferior inteira quando a tela é tocada (ver
         applyControlsVisibility em SlideshowActivity), e um botão ali em cima
         cobriria o nome. -->
    <Button
        android:id="@+id/menu_button"
        style="@style/SlideshowMenuButton"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:text="@string/menu_button"
        android:visibility="gone" />

</FrameLayout>
