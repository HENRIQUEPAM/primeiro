<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      NoActionBar: nenhuma tela do app usa a barra de ação do sistema — cada
      uma já desenha o próprio título grande no layout (ver activity_home.xml,
      activity_privacy.xml, activity_people.xml). Com a barra padrão ligada,
      o Android mostrava o android:label do manifesto ali em cima, duplicando
      o título que a tela já tem embaixo. Desligar também dá controle total
      sobre a cor da barra de status, que é a única "barra" que sobra.

      Light, não DayNight: cartões como navy_050/amber_banner_bg são cores
      FIXAS, claras, escritas à mão — não pares dia/claro e noite/escuro.
      Com DayNight, num aparelho em modo escuro do sistema o Material3 troca
      sozinho a cor de texto padrão (android:textColorPrimary, usada por todo
      TextView sem textColor explícito — scan_status, review_remaining,
      títulos de tela) para a variante clara pensada para fundo escuro, que
      cai em cima dos nossos fundos claros e fica ilegível (texto cinza-claro
      sobre cartão quase branco). O app já era visualmente fixo — mesma
      aparência em qualquer aparelho, de propósito, para não confundir quem
      usa — só o texto padrão não sabia disso. Light garante que o Material3
      sempre resolva as cores padrão como se o sistema estivesse em modo
      claro, não importa a configuração do aparelho.
    -->
    <style name="Theme.PortaRetratoChamadas" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/navy_800</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorPrimaryContainer">@color/navy_600</item>
        <item name="colorOnPrimaryContainer">#FFFFFFFF</item>
        <item name="colorSecondary">@color/navy_400</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>

        <item name="android:statusBarColor" tools:targetApi="21">@color/navy_900</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/navy_900</item>
        <!-- Fundo escuro na barra de status pede ícone de relógio/bateria
             claro, não escuro. -->
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <!-- 96dp de altura: alvo de toque confortavel para maos com tremor. -->
    <style name="CallPrimaryButtonBase" parent="Widget.Material3.Button">
        <item name="android:layout_width">150dp</item>
        <item name="android:layout_height">96dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/call_text</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="CallPositiveButton" parent="CallPrimaryButtonBase">
        <item name="backgroundTint">@color/answer_green</item>
    </style>

    <style name="CallDangerButton" parent="CallPrimaryButtonBase">
        <item name="backgroundTint">@color/decline_red</item>
    </style>

    <style name="CallSecondaryButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/call_text</item>
        <item name="backgroundTint">@color/secondary_button</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Botao de acao do cartao de contato: alto, largo e com rotulo em texto. -->
    <style name="ContactActionButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- Único botão do slideshow: largo o bastante para o dedo, mas não
         ocupa a tela inteira como os botões do menu que ele abre. -->
    <style name="SlideshowMenuButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:minWidth">180dp</item>
        <item name="android:textSize">18sp</item>
        <item name="cornerRadius">32dp</item>
    </style>
</resources>
